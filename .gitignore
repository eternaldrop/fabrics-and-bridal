# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; .env.example is the template and stays tracked)
.env
.env.local
.env.*.local

# vercel
.vercel

# Local source images (uploaded to Cloudinary by the db/seed-*-images.ts
# scripts, not tracked here — large binaries, and "images for fabrics/"
# specifically contains a competitor's watermarked photos that must never
# enter git history).
/images for bridal page/
/images for fabrics/

# typescript
*.tsbuildinfo
next-env.d.ts
