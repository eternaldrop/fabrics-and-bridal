# Copy this file to .env.local and fill in real values.
# .env.local is never committed — .env.example is just the template.

# Neon Postgres connection string (Dashboard > your project > Connection Details)
DATABASE_URL=

# Auth.js session encryption secret — generate with: npx auth secret
AUTH_SECRET=

# Cloudinary (Dashboard > Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client-side Cloudinary config (safe to expose — cloud name isn't secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# An UNSIGNED upload preset (Cloudinary Dashboard > Settings > Upload >
# Upload presets > Add upload preset > Signing mode: Unsigned)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Paystack (Phase 2 — not used yet, but the keys go here when ready)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
